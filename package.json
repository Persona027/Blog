{
  "name": "personal-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && tsc -b && tsc -p tsconfig.scripts.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-movies": "tsx scripts/sync-covers-tmdb.ts",
    "sync-books": "tsx scripts/sync-covers-books.ts",
    "content:check": "tsx scripts/content.ts",
    "predev": "npm run content:check",
    "test": "playwright test",
    "sync-animes": "tsx scripts/sync-covers-animes.ts",
    "sync-games": "tsx scripts/sync-covers-games.ts",
    "format": "prettier --write src/App.tsx src/pages src/components src/features src/index.css scripts tests *.ts *.json *.html",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.45",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.12.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
