# TMDB API (用于同步影视封面)
# 在 https://www.themoviedb.org/settings/api 申请
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_token_here

# Bangumi API (用于同步游戏/动画收藏)
# 在 https://bgm.tv/dev/app 创建应用获取
BANGUMI_USERNAME=your_bangumi_user_id
BANGUMI_ACCESS_TOKEN=your_bangumi_access_token_here
